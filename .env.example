# DS2API runtime
# Runtime listen port inside the app/container
PORT=5001
# Docker Compose host port (compose only; container still listens on PORT)
DS2API_HOST_PORT=6011
LOG_LEVEL=INFO

# Admin authentication
DS2API_ADMIN_KEY=change-me

# Multi-User Authentication (optional)
# Set to true to enable multi-user mode with database
DS2API_MULTI_USER=false
# JWT secret for token signing (required if multi-user enabled)
DS2API_JWT_SECRET=change-this-secret-in-production
# Default admin password (optional, default: admin123)
DS2API_ADMIN_PASSWORD=admin123

# Config loading (choose one)
# 1) file-based config
DS2API_CONFIG_PATH=/app/config.json
# 2) inline JSON or Base64 JSON
# DS2API_CONFIG_JSON=
# 3) legacy compatibility alias
# CONFIG_JSON=

# Optional: static admin assets path
# DS2API_STATIC_ADMIN_DIR=/app/static/admin
